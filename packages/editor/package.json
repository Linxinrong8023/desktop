{
  "name": "@ora/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./composer": "./src/composer/index.ts"
  },
  "scripts": {
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src tests --max-warnings 0",
    "test": "node ../../scripts/run-with-clean-stderr.mjs \"tsc -p tsconfig.json --noEmit && node --import tsx --test tests/*.test.ts\""
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@tiptap/core": "^3.0.7",
    "@tiptap/extension-bold": "^3.0.7",
    "@tiptap/extension-code": "^3.0.7",
    "@tiptap/extension-highlight": "^3.0.7",
    "@tiptap/extension-horizontal-rule": "^3.0.7",
    "@tiptap/extension-image": "^3.0.7",
    "@tiptap/extension-italic": "^3.0.7",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-list": "^3.0.7",
    "@tiptap/extension-strike": "^3.0.7",
    "@tiptap/extension-subscript": "^3.0.7",
    "@tiptap/extension-superscript": "^3.0.7",
    "@tiptap/extension-text-align": "^3.0.7",
    "@tiptap/extension-typography": "^3.0.7",
    "@tiptap/extension-underline": "^3.0.7",
    "@tiptap/extensions": "^3.0.7",
    "@tiptap/pm": "^3.0.7",
    "@tiptap/react": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "lodash": "^4.17.21",
    "react-hotkeys-hook": "^4.6.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/react": "^19.1.8",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  }
}
